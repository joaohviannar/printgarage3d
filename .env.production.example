# =====================================================
# Print Garage 3D - Configuracao de Producao (Hostinger)
# =====================================================
# Renomeie este arquivo para .env no servidor de producao
# e ajuste os valores marcados com [PREENCHER]

APP_NAME="Print Garage 3D"
APP_ENV=production
APP_KEY=[PREENCHER_COM_php_artisan_key_generate]
APP_DEBUG=false
APP_URL=https://printgarage3d.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===== BANCO DE DADOS (Hostinger) =====
# Copie do hPanel > Hospedagem > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=[PREENCHER_NOME_DO_BANCO]
DB_USERNAME=[PREENCHER_USUARIO]
DB_PASSWORD=[PREENCHER_SENHA]

# ===== SESSAO E CACHE =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Em producao usar database para cache (Redis seria melhor mas Hostinger Premium nao tem)
CACHE_STORE=database
CACHE_PREFIX=

# Filas em sync para Premium (sem Redis/queue worker dedicado)
QUEUE_CONNECTION=database

# ===== STORAGE =====
FILESYSTEM_DISK=public

# ===== MAIL (configurar quando precisar enviar emails) =====
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contato@printgarage3d.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ===== VITE (assets ja foram buildados em /public/build) =====
VITE_APP_NAME="${APP_NAME}"
